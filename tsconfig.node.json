{
  "compilerOptions": {
    "composite": true,
    // Composite projects have to emit. Send the output out of the project root:
    // a generated vite.config.js sitting next to vite.config.ts shadows it in
    // Vite's config lookup, so a stale build artifact would quietly win.
    "outDir": "node_modules/.tmp/tsconfig-node",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "types": ["node"]
  },
  "include": ["vite.config.ts"]
}
